# PostgreSQL Configuration
POSTGRES_USER=harcon_admin
POSTGRES_PASSWORD=harcon_secure_pass
POSTGRES_DB=harcon_precision

# Database Connection URL (Localhost default)
DATABASE_URL=postgresql://harcon_admin:harcon_secure_pass@localhost:5432/harcon_precision?schema=public

# Application Ports
PORT=4000
FRONTEND_PORT=3000

# Authentication
JWT_SECRET=harcon-precision-super-secure-jwt-secret-key-32-chars-min!

# CORS / URLs
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:4000
