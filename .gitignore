# ==========================================
# Dependencies & Build Outputs
# ==========================================
*/node_modules/
*/dist/
*/build/
*/out/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Frontend (React Router v7 & Vite)
# ==========================================
# Ignore React Router's auto-generated types and server build outputs
frontend/.react-router/
# Ignore Vite cache
frontend/.vite/
frontend/eslint-cache/

# ==========================================
# Backend (Node/Express/Prisma)
# ==========================================
# Ignore user uploads (CAD files, PDFs from quote requests) but keep the directory
backend/uploads/*
!backend/uploads/.gitkeep

# ==========================================
# Testing
# ==========================================
coverage/
.nyc_output/

# ==========================================
# Logs
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ==========================================
# OS & IDE / Editor
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?